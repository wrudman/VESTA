# VESTA Environment Variables
# Copy this file to .env and fill in the keys for your provider.

# ─── Model Override ────────────────────────────────────────────────────
# The LiteLLM model string used by the harbor task. LiteLLM supports 100+
# providers via the model prefix convention: https://docs.litellm.ai/docs/providers
#
# Common examples:
#   azure/gpt-5-mini          → Azure OpenAI
#   bedrock/us.anthropic.claude-sonnet-4-20250514-v1:0  → AWS Bedrock
#   together_ai/meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8  → Together AI
#   openrouter/anthropic/claude-sonnet-4-20250514  → OpenRouter
#   gpt-4o-mini               → OpenAI direct
#VESTA_MODEL_ID=azure/gpt-5-mini

# ─── LiteLLM Params Override ────────────────────────────────────────────
# Optional JSON dict forwarded verbatim to the LiteLLM backend.  Keys here
# take precedence over the params VESTA computes from reasoning_effort /
# api_base settings.  Must be a valid single-quoted JSON string:
#   VESTA_LITELLM_PARAMS='{"reasoning_effort": "high"}'
#VESTA_LITELLM_PARAMS='{"reasoning_effort": "low"}'

# ─── Azure OpenAI ────────────────────────────────────────────────────
# AZURE_API_KEY=your-azure-api-key
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-12-01-preview

# ─── OpenAI ──────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ─── Anthropic ───────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ─── AWS Bedrock ─────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1

# ─── Together AI ─────────────────────────────────────────────────────
# TOGETHERAI_API_KEY=tgp_v1_...

# ─── OpenRouter ──────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
